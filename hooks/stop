#!/usr/bin/env bash
# Stop hook for long-task-agent plugin
# Keeps Claude working on failing features within a session.
# When all active features pass (or stop_hook_active=true), allows stop.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read hook input from stdin
INPUT=$(cat)

# Parse stop_hook_active flag using python3 (cross-platform, no jq dependency)
STOP_ACTIVE=$(echo "$INPUT" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(str(d.get('stop_hook_active', False)).lower())
except Exception:
    print('false')
" 2>/dev/null || echo "false")

# Safety valve: when stop_hook_active=true, Claude is already continuing
# from a previous stop hook block. Must allow stop to prevent infinite loops.
if [ "$STOP_ACTIVE" = "true" ]; then
    exit 0
fi

# No feature-list.json → not in Worker phase, allow stop
if [ ! -f "feature-list.json" ]; then
    exit 0
fi

# Read feature status (python3 cross-platform, no jq dependency)
read total passing <<< $(python3 -c "
import json
try:
    d = json.load(open('feature-list.json'))
    fs = [f for f in d.get('features', []) if not f.get('deprecated', False)]
    t = len(fs)
    p = sum(1 for f in fs if f.get('status') == 'passing')
    print(t, p)
except Exception:
    print('0 0')
" 2>/dev/null || echo "0 0")

# All active features passing → allow stop (enter ST phase or done)
if [ "$total" = "$passing" ] && [ "$total" != "0" ]; then
    exit 0
fi

# No features at all → allow stop
if [ "$total" = "0" ]; then
    exit 0
fi

# Still has failing features → block stop, tell Claude to continue
python3 -c "
import json
print(json.dumps({
    'decision': 'block',
    'reason': 'There are still failing features (${passing}/${total} passing). Please continue working on the next failing feature. If context is running low, save progress (commit + update task-progress.md) before ending.'
}))
"
